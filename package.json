{
  "name": "root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=!clarigen-docs --filter=!@clarigen/web-tools",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "turbo run test --continue",
    "typecheck": "turbo run typecheck --continue --filter=!clarigen-docs",
    "publish-packages": "vp run build:packages && vp update && turbo run publish --continue --concurrency=1",
    "publish-local": "vp run build:packages && pnpm -r publish",
    "publish-changesets": "vp run build:packages && changeset publish",
    "demo-types": "pnpm --filter @clarigen/cli start ../../demo-project",
    "clarigen": "pnpm --filter @clarigen/cli start",
    "dev:web": "pnpm --filter clarigen-docs dev",
    "dev:tools": "turbo run dev --filter=@clarigen/web-tools --log-prefix=none"
  },
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "@changesets/changelog-github": "0.5.0",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "24.2.0",
    "@vitest/coverage-v8": "4.1.8",
    "husky": "^4.3.8",
    "next": "14.2.35",
    "shx": "^0.3.4",
    "tslib": "^2.8.1",
    "turbo": "2.6.3",
    "typedoc": "0.25.13",
    "typescript": "5.9.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@changesets/cli": "^2.31.0",
    "jsonfile": "^6.2.1"
  },
  "resolutions": {
    "typescript": "5.9.3",
    "whatwg-url": "^14.0.0"
  },
  "pnpm": {
    "overrides": {
      "whatwg-url": "^14.0.0",
      "vite": "catalog:"
    }
  }
}
