{
  "version": "4.1.7",
  "license": "MIT",
  "types": "./dist/index.d.cts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./run-cli": {
      "import": "./dist/run-cli.mjs",
      "require": "./dist/run-cli.cjs"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=10"
  },
  "bin": {
    "cli": "./dist/run-cli.mjs"
  },
  "scripts": {
    "start": "tsx src/run-cli.ts",
    "dev": "vp pack --watch",
    "build": "vp pack",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && vp fmt --check \"./**/*.{ts,js}\"",
    "format:fix": "vp fmt \"./**/*.{ts,js}\"",
    "typecheck": "tsc --noEmit -p tsconfig-test.json",
    "type-stubs": "tsx scripts/generate-type-stubs.ts && vp fmt --loglevel error ./src/**/*.ts",
    "publish": "pnpm publish"
  },
  "name": "@clarigen/cli",
  "author": "Hank Stoever",
  "devDependencies": {
    "@stacks/clarinet-sdk": "3.19.0",
    "@stacks/clarinet-sdk-wasm": "3.19.0",
    "tsx": "^4.7.2"
  },
  "peerDependencies": {
    "@stacks/clarinet-sdk": "^3.9.2",
    "@stacks/clarinet-sdk-wasm": "^3.9.2"
  },
  "dependencies": {
    "@antfu/ni": "^0.21.12",
    "@clarigen/core": "workspace:*",
    "@clarigen/docs": "workspace:*",
    "@iarna/toml": "^2.2.5",
    "@stacks/transactions": "7.1.0",
    "arktype": "^2.1.25",
    "chokidar": "^3.6.0",
    "clipanion": "4.0.0-rc.3",
    "execa": "^8.0.1",
    "ora": "^8.0.1",
    "pino": "^8.20.0",
    "pino-pretty": "^11.0.0",
    "smol-toml": "^1.1.4",
    "yaml": "^2.4.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs"
}
