{
  "version": "4.1.7",
  "license": "MIT",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "import": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "vp pack --watch",
    "dev": "vp pack --watch",
    "build": "vp pack",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && vp fmt --check \"./**/*.{ts,js}\"",
    "typecheck": "tsc --noEmit -p tsconfig-test.json",
    "copy-types": "node copy-types.js",
    "publish": "pnpm publish"
  },
  "name": "@clarigen/core",
  "author": "Hank Stoever",
  "dependencies": {
    "@scure/base": "^1.2.6",
    "@stacks/blockchain-api-client": "7.10.0",
    "@stacks/common": "^7.3.1",
    "@stacks/network": "^7.3.1",
    "@stacks/stacks-blockchain-api-types": "7.10.0",
    "@stacks/transactions": "7.1.0"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./deployment": {
      "import": "./dist/deployment.mjs",
      "require": "./dist/deployment.cjs"
    },
    "./package.json": "./package.json"
  }
}
