{
  "version": "4.1.7",
  "license": "MIT",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./mainnet": {
      "import": "./dist/mainnet.mjs",
      "require": "./dist/mainnet.cjs"
    },
    "./testnet": {
      "import": "./dist/testnet.mjs",
      "require": "./dist/testnet.cjs"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "tsx src/run-cli.ts",
    "dev": "vp pack --watch",
    "build": "shx rm -rf dist && vp pack",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && vp fmt --check \"./**/*.{ts,js}\"",
    "format:fix": "vp fmt \"./**/*.{ts,js}\"",
    "typecheck": "tsc --noEmit -p tsconfig-test.json",
    "type-stubs": "clarigen",
    "publish": "pnpm publish"
  },
  "name": "@clarigen/boot",
  "author": "Hank Stoever",
  "devDependencies": {
    "tsx": "^4.7.2"
  },
  "dependencies": {
    "@clarigen/core": "workspace:*",
    "@clarigen/cli": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs"
}
