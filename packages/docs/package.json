{
  "name": "@clarigen/docs",
  "version": "4.1.7",
  "public": true,
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "import": "./dist/index.mjs",
  "scripts": {
    "start": "vp pack --watch",
    "dev": "vp pack --watch",
    "build": "shx rm -rf ./dist && vp pack",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && vp fmt --check \"./**/*.{ts,js}\"",
    "typecheck": "tsc --noEmit -p tsconfig-test.json",
    "publish": "pnpm publish"
  },
  "author": "Hank Stoever",
  "dependencies": {
    "@clarigen/core": "workspace:*"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
