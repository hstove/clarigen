{
  "globalDependencies": ["tsconfig.json", "vite.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "installer/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/demo-project/**",
        "!$TURBO_ROOT$/demo-project/node_modules/**",
        "!$TURBO_ROOT$/demo-project/dist/**"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/demo-project/**",
        "!$TURBO_ROOT$/demo-project/node_modules/**",
        "!$TURBO_ROOT$/demo-project/dist/**"
      ],
      "outputs": []
    },
    "type-stubs": {
      "outputs": []
    },
    "publish": {
      "outputs": [],
      "dependsOn": ["^publish"]
    },
    "deploy": {
      "cache": false,
      "outputs": []
    }
  },
  "globalEnv": ["NODE_ENV", "NEXT_PUBLIC_STACKS_API_URL", "CI", "LOG_TX_CALLS"]
}
